# ---- 登录账号（单用户）----------------------------------------------
# 用户名；密码只存哈希，绝不写明文到代码或配置
CHAT_USERNAME=admin

# 生成方式：python scripts/hash_password.py
# 把输出整行粘贴到下面（形如 pbkdf2:sha256:600000$...$...）
CHAT_PASSWORD_HASH=

# 备选：直接给明文密码，服务端启动时自行哈希入库（仅推荐本地开发）
# CHAT_PASSWORD=

# 既没配 CHAT_PASSWORD_HASH 也没配 CHAT_PASSWORD 时，首次启动会生成随机密码并打印到日志
CHAT_ALLOW_GENERATED_PASSWORD=1

# ---- Session -------------------------------------------------------
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 留空则自动生成并持久化到 data/secret_key
FLASK_SECRET_KEY=
SESSION_LIFETIME_HOURS=336
# 通过 HTTPS 部署时置 1
SESSION_COOKIE_SECURE=0

# ---- 数据落地 ------------------------------------------------------
CHAT_DATA_DIR=./data

# ---- DeepSeek 上游 -------------------------------------------------
DEEPSEEK_API_ORIGIN=https://api.deepseek.com
UPSTREAM_CONNECT_TIMEOUT=15
UPSTREAM_READ_TIMEOUT=300

# ---- 前端产物 ------------------------------------------------------
# 默认 ./public（由 scripts/build_frontend.sh 从仓库 dist/ 拷贝）
STATIC_DIST=./public

# ---- 其它 ----------------------------------------------------------
MAX_CONTENT_LENGTH_MB=64
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300
